# Keep source and generated text stable across Windows and other systems.
*.R text eol=lf
*.Rproj text eol=lf
*.md text eol=lf
*.csv text eol=lf
# Raw responses and binary sources must retain their downloaded bytes.
data/raw/** -text
*.png binary
*.xlsx binary
*.nc binary
# Downloaded sources and generated results are not authored program code.
data/raw/** linguist-vendored
data/derived/** linguist-generated
data/spatial/** linguist-generated
outputs/** linguist-generated
*.shp binary
*.shx binary
*.dbf binary
