    family-names: Atanasov
    affiliation: "University of Applied Sciences and Arts Northwestern Switzerland (FHNW)"
  - given-names: Pirasanna
    family-names: Siva
    affiliation: "University of Applied Sciences and Arts Northwestern Switzerland (FHNW)"
keywords:
  - coral spawning
  - circular statistics
  - reproducible research
  - R
  - data science
