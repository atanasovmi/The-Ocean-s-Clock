source("run.R", encoding = "UTF-8")
calendar_weights <- readr::read_csv("data/derived/spawning_calendar_weights.csv", show_col_types = FALSE)
calendar_exposure <- readr::read_csv("data/derived/calendar_exposure.csv", show_col_types = FALSE)
model_scores <- readr::read_csv("outputs/tables/aquarium_model_scores.csv", show_col_types = FALSE)
aquarium_models <- readRDS("outputs/models/aquarium_models.rds")
print(model_scores[, c("model", "n_days", "brier", "mean_within_year_auc")])
save(calendar_weights, calendar_exposure, model_scores, aquarium_models, file = ".RData", compress = "xz")
savehistory(".Rhistory")
save(calendar_weights, calendar_exposure, model_scores, aquarium_models, file = "outputs/models/analysis_workspace.RData", compress = "xz")
savehistory("outputs/session.Rhistory")
